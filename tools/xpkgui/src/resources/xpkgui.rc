#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "New...\tCtrl+N", ID_FILE_NEW
        MENUITEM "Open...\tCtrl+O", ID_FILE_OPEN
        POPUP "Recent Archives"
        BEGIN
            MENUITEM "(Empty)", 0, GRAYED
        END
        MENUITEM "Close\tCtrl+W", ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Save\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Save As...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM "Rebuild", ID_FILE_REBUILD
        MENUITEM "Archive Properties", ID_FILE_PROPERTIES
        MENUITEM "Show Archive In Explorer", ID_FILE_SHOW_ARCHIVE_IN_EXPLORER
        MENUITEM "Copy Archive Path", ID_FILE_COPY_ARCHIVE_PATH
        MENUITEM SEPARATOR
        MENUITEM "Exit", ID_FILE_EXIT
    END
    POPUP "Archive"
    BEGIN
        MENUITEM "Add Files...", ID_ACTION_ADD_FILES
        MENUITEM "Add Folder...", ID_ACTION_ADD_FOLDER
        MENUITEM "Add Empty Entry...", ID_ACTION_ADD_EMPTY
        MENUITEM "Create Text Entry...", ID_ACTION_CREATE_TEXT
        MENUITEM SEPARATOR
        MENUITEM "Open\tEnter", ID_ACTION_OPEN
        MENUITEM "View\tF3", ID_ACTION_VIEW
        MENUITEM "Edit Text...", ID_ACTION_EDIT_TEXT
        MENUITEM "Edit Externally\tF4", ID_ACTION_EDIT
        MENUITEM "Replace...", ID_ACTION_REPLACE
        MENUITEM "Duplicate Entry...", ID_ACTION_DUPLICATE
        MENUITEM "Open With...", ID_ACTION_OPEN_WITH
        MENUITEM "Show In Explorer", ID_ACTION_SHOW_IN_EXPLORER
        MENUITEM "Extract Selected...", ID_ACTION_EXTRACT
        MENUITEM "Extract All...", ID_ACTION_EXTRACT_ALL
        MENUITEM SEPARATOR
        MENUITEM "Delete\tDelete", ID_ACTION_DELETE
        MENUITEM "Rename\tF2", ID_ACTION_RENAME
        MENUITEM "Copy To...", ID_ACTION_COPY_TO
        MENUITEM "Move To...", ID_ACTION_MOVE_TO
        MENUITEM "Set FileIndex...", ID_ACTION_SET_FILE_INDEX
        MENUITEM "Set File Type...", ID_ACTION_SET_FILE_TYPE
        MENUITEM "Set Platform Attr...", ID_ACTION_SET_PATH_ATTR
        MENUITEM "Properties\tAlt+Enter", ID_ACTION_PROPERTIES
        MENUITEM "View/Edit Entry InfoExt...", ID_ACTION_INFO_EXT
        MENUITEM "Import Entry InfoExt...", ID_ACTION_INFO_EXT_IMPORT
        MENUITEM "Export Entry InfoExt...", ID_ACTION_INFO_EXT_EXPORT
        MENUITEM "Clear Entry InfoExt", ID_ACTION_INFO_EXT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "Verify Selected", ID_ACTION_VERIFY
        MENUITEM "Verify All", ID_ACTION_VERIFY_ALL
    END
    POPUP "Edit"
    BEGIN
        MENUITEM "Copy Selected Names/Paths\tCtrl+C", ID_EDIT_COPY_PATHS
        MENUITEM "Copy Visible Names/Paths", ID_EDIT_COPY_VISIBLE_PATHS
        MENUITEM "Export Selected Names/Paths...", ID_EDIT_EXPORT_PATHS
        MENUITEM "Export Visible Names/Paths...", ID_EDIT_EXPORT_VISIBLE_PATHS
        MENUITEM "Copy Selected Details", ID_EDIT_COPY_DETAILS
        MENUITEM "Copy Visible List Details", ID_EDIT_COPY_VISIBLE_DETAILS
        MENUITEM "Export Selected Details...", ID_EDIT_EXPORT_DETAILS
        MENUITEM "Export Visible List Details...", ID_EDIT_EXPORT_VISIBLE_DETAILS
        MENUITEM "Copy Entry Hash", ID_EDIT_COPY_HASH
        MENUITEM "Copy Selected Hashes", ID_EDIT_COPY_HASHES
        MENUITEM "Copy Visible Hashes", ID_EDIT_COPY_VISIBLE_HASHES
        MENUITEM "Export Selected Hashes...", ID_EDIT_EXPORT_HASHES
        MENUITEM "Export Visible Hashes...", ID_EDIT_EXPORT_VISIBLE_HASHES
        MENUITEM SEPARATOR
        MENUITEM "Select All\tCtrl+A", ID_VIEW_SELECT_ALL
        MENUITEM "Deselect All\tCtrl+Shift+A", ID_EDIT_DESELECT_ALL
        MENUITEM "Invert Selection", ID_EDIT_INVERT_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "Select By Pattern...", ID_EDIT_SELECT_BY_PATTERN
        MENUITEM "Deselect By Pattern...", ID_EDIT_DESELECT_BY_PATTERN
        MENUITEM "Select Same Extension", ID_EDIT_SELECT_SAME_EXT
        MENUITEM "Select Same Hash", ID_EDIT_SELECT_SAME_HASH
        MENUITEM "Select Same Method", ID_EDIT_SELECT_SAME_METHOD
        MENUITEM "Select Same File Type", ID_EDIT_SELECT_SAME_FILETYPE
        MENUITEM "Select Same Platform Attr", ID_EDIT_SELECT_SAME_ATTR
        MENUITEM "Select Duplicate Files", ID_EDIT_SELECT_DUPLICATES
        MENUITEM "Select Duplicate Copies", ID_EDIT_SELECT_DUP_COPIES
        MENUITEM "Delete Duplicate Copies...", ID_EDIT_DELETE_DUP_COPIES
    END
    POPUP "Tools"
    BEGIN
        MENUITEM "Archive Settings...", ID_TOOLS_ARCHIVE_SETTINGS
        MENUITEM "View/Edit Meta...", ID_TOOLS_META_EDIT
        MENUITEM SEPARATOR
        MENUITEM "Import Meta...", ID_TOOLS_META_IMPORT
        MENUITEM "Export Meta...", ID_TOOLS_META_EXPORT
        MENUITEM "Clear Meta", ID_TOOLS_META_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "Show Settings File", ID_TOOLS_SHOW_SETTINGS_FILE
        MENUITEM "Reset UI Preferences...", ID_TOOLS_RESET_UI_PREFS
    END
    POPUP "View"
    BEGIN
        MENUITEM "Back\tAlt+Left", ID_VIEW_BACK
        MENUITEM "Forward\tAlt+Right", ID_VIEW_FORWARD
        MENUITEM "Up\tAlt+Up", ID_VIEW_PARENT
        MENUITEM "Root\tAlt+Home", ID_VIEW_ROOT
        MENUITEM SEPARATOR
        MENUITEM "Refresh\tF5", ID_VIEW_REFRESH
        MENUITEM "Focus Filter\tCtrl+F", ID_VIEW_FOCUS_FILTER
        MENUITEM "Clear Filter\tEsc", ID_VIEW_CLEAR_FILTER
        MENUITEM "Focus Path\tCtrl+L", ID_VIEW_FOCUS_PATH
        MENUITEM SEPARATOR
        MENUITEM "Flat View", ID_VIEW_FLAT
        MENUITEM "Locate In Tree", ID_VIEW_LOCATE_IN_TREE
        MENUITEM SEPARATOR
        MENUITEM "Show Grid Lines", ID_VIEW_GRID_LINES
        MENUITEM "Full Row Select", ID_VIEW_FULL_ROW_SELECT
        MENUITEM "Columns...", ID_VIEW_COLUMNS
        MENUITEM SEPARATOR
        MENUITEM "Reset Sort", ID_VIEW_RESET_SORT
        MENUITEM "Auto Size Columns\tCtrl+Num+", ID_VIEW_AUTO_SIZE_COLUMNS
        MENUITEM "Reset Columns", ID_VIEW_RESET_COLUMNS
    END
    POPUP "Help"
    BEGIN
        MENUITEM "Keyboard Shortcuts", ID_HELP_KEYBOARD_SHORTCUTS
        MENUITEM "Command Line Usage", ID_HELP_COMMAND_LINE
        MENUITEM SEPARATOR
        MENUITEM "About", ID_HELP_ABOUT
    END
END

IDD_ARCHIVE_CONFIG DIALOGEX 0, 0, 340, 252
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Archive Configuration"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Archive Path",      -1,                     10, 12, 80, 10
    EDITTEXT    IDC_CFG_ARCHIVE_PATH,                        10, 24, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON  "Browse...",         IDC_CFG_BROWSE,         266, 23, 62, 16

    LTEXT       "Pack Type",         -1,                     10, 48, 80, 10
    COMBOBOX    IDC_CFG_PACK_TYPE,                           10, 60, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Write Policy",      -1,                     180, 48, 80, 10
    COMBOBOX    IDC_CFG_WRITE_POLICY,                        180, 60, 120, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "Default Comp",      -1,                     10, 86, 80, 10
    COMBOBOX    IDC_CFG_DEFAULT_COMP,                        10, 98, 150, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Meta Comp",         -1,                     180, 86, 80, 10
    COMBOBOX    IDC_CFG_META_COMP,                           180, 98, 150, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "Info Comp",         -1,                     10, 124, 80, 10
    COMBOBOX    IDC_CFG_INFO_COMP,                           10, 136, 150, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "InfoExt Size",      -1,                     180, 124, 80, 10
    EDITTEXT    IDC_CFG_INFOEXT_SIZE,                        180, 136, 70, 14, ES_AUTOHSCROLL | ES_NUMBER

    CONTROL     "Solid Layout",      IDC_CFG_SOLID_MODE,     "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 164, 100, 12
    LTEXT       "Volume Size",       -1,                     180, 162, 80, 10
    EDITTEXT    IDC_CFG_VOLUME_SIZE,                         180, 176, 70, 14, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT       "Changing Pack Type changes entry semantics. Solid/Volume layout changes take effect after Rebuild.", -1, 10, 198, 318, 18
    LTEXT       "Volume Size 0 disables volumes; non-zero values split output and require all parts for extraction.", -1, 10, 220, 318, 10

    DEFPUSHBUTTON "OK",              IDOK,                   84, 232, 70, 16
    PUSHBUTTON    "Cancel",          IDCANCEL,               184, 232, 70, 16
END

IDD_INPUT_DIALOG DIALOGEX 0, 0, 250, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Input",             IDC_INPUT_PROMPT,       10, 10, 230, 10
    EDITTEXT    IDC_INPUT_VALUE,                             10, 24, 230, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK",              IDOK,                   56, 52, 60, 16
    PUSHBUTTON    "Cancel",          IDCANCEL,               136, 52, 60, 16
END

IDD_TASK_PROGRESS DIALOGEX 0, 0, 260, 100
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Processing"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Working...",        IDC_TASK_STATUS,        10, 12, 240, 10
    LTEXT       "",                  IDC_TASK_DETAIL,        10, 25, 240, 16, SS_PATHELLIPSIS
    CONTROL     "",                  IDC_TASK_PROGRESS_BAR,  "msctls_progress32", WS_CHILD | WS_VISIBLE | PBS_SMOOTH, 10, 48, 240, 14
    PUSHBUTTON  "Cancel",            IDCANCEL,               100, 74, 60, 16
END

IDD_TEXT_EDITOR DIALOGEX 0, 0, 360, 220
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Text Editor"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Text",              IDC_TEXT_PROMPT,        10, 10, 340, 18
    EDITTEXT    IDC_TEXT_VALUE,                             10, 30, 340, 160, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON "OK",              IDOK,                   110, 198, 60, 16
    PUSHBUTTON    "Cancel",          IDCANCEL,               190, 198, 60, 16
END

IDD_COLUMNS_DIALOG DIALOGEX 0, 0, 230, 178
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Columns"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Choose columns to show in the archive list.", -1, 10, 10, 210, 10
    CONTROL     "Name / Path",      IDC_COL_NAME,       "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 28, 95, 12
    CONTROL     "Size",             IDC_COL_SIZE,       "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 28, 80, 12
    CONTROL     "Packed",           IDC_COL_PACKED,     "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 44, 95, 12
    CONTROL     "Ratio",            IDC_COL_RATIO,      "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 44, 80, 12
    CONTROL     "Method",           IDC_COL_METHOD,     "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 60, 95, 12
    CONTROL     "File Type",        IDC_COL_FILE_TYPE,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 60, 80, 12
    CONTROL     "Modified",         IDC_COL_MODIFIED,   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 76, 95, 12
    CONTROL     "ID",               IDC_COL_ID,         "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 76, 80, 12
    CONTROL     "Hash",             IDC_COL_HASH,       "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 92, 95, 12
    CONTROL     "Attr",             IDC_COL_ATTR,       "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 92, 80, 12
    LTEXT       "Name / Path is always visible.", -1, 10, 116, 210, 10
    DEFPUSHBUTTON "OK",             IDOK,               48, 148, 60, 16
    PUSHBUTTON    "Cancel",         IDCANCEL,           122, 148, 60, 16
END
